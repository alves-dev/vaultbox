# Copy to .env.vaultbox, chmod 600, and replace every value.
VAULTBOX_AGE_KEY=AGE-SECRET-KEY-REPLACE_ME
VAULTBOX_AGE_RECIPIENT=age1replace_me
# JSON array. Use sha256:<sha256(token)> to avoid storing API tokens in this file.
VAULTBOX_API_KEYS=["replace-with-a-long-random-token"]
VAULTBOX_WEB_USERNAME=admin
VAULTBOX_WEB_PASSWORD=replace-with-a-long-password
VAULTBOX_SESSION_SECRET=replace-with-a-long-random-session-secret
VAULTBOX_COOKIE_SECURE=true
VAULTBOX_ENABLE_DOCS=false
