# Vaultbox runtime configuration.
# Fill these values manually on each server. Do not put production secrets in Git.

# Complete age identity file contents, including the "AGE-SECRET-KEY-" line.
VAULTBOX_AGE_KEY=

# Age recipient/public key corresponding to VAULTBOX_AGE_KEY.
VAULTBOX_AGE_RECIPIENT=

# JSON array of API keys, for example: ["replace-with-a-long-random-token"]
VAULTBOX_API_KEYS=[]

# Web login credentials and session signing secret.
VAULTBOX_WEB_USERNAME=
VAULTBOX_WEB_PASSWORD=
VAULTBOX_SESSION_SECRET=

# HTTPS is expected when exposed through the reverse proxy.
VAULTBOX_COOKIE_SECURE=true
VAULTBOX_ENABLE_DOCS=false
